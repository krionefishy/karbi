# Public entry point
HTTP_PORT=8080
APP_ENVIRONMENT=production
APP_LOG_LEVEL=INFO

# PostgreSQL
DB_USER=karbi
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=karbi

# Redis
REDIS_PASSWORD=replace-with-a-strong-password

# Kafka
KAFKA_ENABLED=true

# Authentication and encrypted WB credentials
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIALS_ENCRYPTION_KEYS=replace-with-a-fernet-key
CREDENTIALS_FINGERPRINT_KEY=replace-with-at-least-32-random-characters

# HTTP rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Wildberries worker
WB_FEEDBACK_PAGE_SIZE=5000
WB_FEEDBACK_REQUEST_INTERVAL_SECONDS=0.0
WB_FEEDBACK_RETRY_WAIT_SECONDS=600

# Coarse safety net for the first WB call; after that the client paces itself
# from the X-Ratelimit-* headers, which differ sixfold by token type.
WB_RATE_WINDOW_SECONDS=60
WB_CONTENT_PER_KEY=90
WB_CONTENT_PER_HOST=90
WB_FEEDBACKS_PER_KEY=55
WB_FEEDBACKS_PER_HOST=55
WB_STATISTICS_PER_KEY=6
WB_STATISTICS_PER_HOST=30
WB_MARKETPLACE_PER_KEY=60
WB_MARKETPLACE_PER_HOST=120
WB_RATE_MAX_WAIT_SECONDS=120

# Turnover automation: alert below this many days of stock, digest hour (MSK)
TURNOVER_THRESHOLD_DAYS=10
TURNOVER_DIGEST_HOUR=10
TURNOVER_NOTIFICATION_BOT=turnover-alerts

# Messenger relay outside Russia: the only host that reaches the messenger.
# Bot tokens live there, not here. The JWT secret is the same on both sides.
RELAY_BASE_URL=https://relay-nl-1.internal:8443
# No public DNS record points at the relay: the address is resolved here.
RELAY_HOST_IP=203.0.113.10
RELAY_JWT_SECRET=replace-with-at-least-32-random-characters
RELAY_VERIFY=/etc/relay/relay.crt

# Telegram notifications (bots are registered with
# `python -m backend.commands.register_bot`, which hands the token to the relay)
TELEGRAM_INVITE_LINK_TTL_HOURS=72
TELEGRAM_SEND_MAX_ATTEMPTS=5

# Optional S3-compatible storage
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_TENANT_ID=
S3_KEY_ID=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ru-central-1
S3_VERIFY_TLS=true
