# Public entry point. Домены не хранятся в репозитории: хостовые конфиги
# nginx рендерятся из этих значений скриптом deploy/nginx/render-hosts.sh.
PUBLIC_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
HTTP_PORT=8080
APP_ENVIRONMENT=production
APP_LOG_LEVEL=INFO

# PostgreSQL
DB_USER=karbi
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=karbi

# Redis
REDIS_PASSWORD=replace-with-a-strong-password

# Kafka
KAFKA_ENABLED=true

# Authentication and encrypted WB credentials
JWT_SECRET=replace-with-at-least-32-random-characters
# Шлюз wb-egress: ключи селлеров, троттлинг WB и исходящие IP живут там.
EGRESS_URL=https://egress.internal:8443
EGRESS_HOST_IP=replace-with-the-egress-vps-ip
EGRESS_JWT_SECRET=replace-with-at-least-32-random-characters
EGRESS_VERIFY=/etc/egress/egress.crt

# HTTP rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Wildberries worker
WB_FEEDBACK_PAGE_SIZE=5000
WB_FEEDBACK_REQUEST_INTERVAL_SECONDS=0.0
WB_FEEDBACK_RETRY_WAIT_SECONDS=600

# Coarse safety net for the first WB call; after that the client paces itself
# from the X-Ratelimit-* headers, which differ sixfold by token type.

# Turnover automation: alert below this many days of stock, digest hour (MSK)
TURNOVER_THRESHOLD_DAYS=10
TURNOVER_DIGEST_HOUR=10
TURNOVER_NOTIFICATION_BOT=turnover-alerts

# Messenger relay outside Russia: the only host that reaches the messenger.
# Bot tokens live there, not here. The JWT secret is the same on both sides.
# Имя релея нигде публично не резолвится — адрес подставляется здесь.
RELAY_HOST_NAME=relay.internal
RELAY_HOST_IP=203.0.113.10
RELAY_BASE_URL=https://relay.internal:8443
RELAY_JWT_SECRET=replace-with-at-least-32-random-characters
RELAY_VERIFY=/etc/relay/relay.crt
# Сколько релей держит наш запрос за апдейтами, если писать нечего
RELAY_UPDATES_WAIT_SECONDS=25

# Telegram notifications (bots are registered with
# `python -m backend.commands.register_bot`, which hands the token to the relay)
TELEGRAM_INVITE_LINK_TTL_HOURS=72
TELEGRAM_SEND_MAX_ATTEMPTS=5

# Optional S3-compatible storage
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_TENANT_ID=
S3_KEY_ID=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ru-central-1
S3_VERIFY_TLS=true
