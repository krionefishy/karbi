# Public entry point
HTTP_PORT=8080
APP_ENVIRONMENT=production
APP_LOG_LEVEL=INFO

# PostgreSQL
DB_USER=karbi
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=karbi

# Redis
REDIS_PASSWORD=replace-with-a-strong-password

# Kafka
KAFKA_ENABLED=true

# Authentication and encrypted WB credentials
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIALS_ENCRYPTION_KEYS=replace-with-a-fernet-key
CREDENTIALS_FINGERPRINT_KEY=replace-with-at-least-32-random-characters

# HTTP rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Wildberries worker
WB_FEEDBACK_PAGE_SIZE=5000

# Optional S3-compatible storage
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_TENANT_ID=
S3_KEY_ID=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ru-central-1
S3_VERIFY_TLS=true
