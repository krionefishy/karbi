{
  "application": "marketplace-auto",
  "environment": "production",
  "topology": "direct",
  "base_path": "/api/v1",
  "log_path": "/var/log/nginx/marketplace-auto-monitoring.json",
  "rotated_glob": "/var/log/nginx/marketplace-auto-monitoring.json.[0-9]",
  "exclude_paths": [
    "/api/v1/health/live",
    "/api/v1/health/ready"
  ],
  "max_routes": 2000,
  "route_rules": [
    {
      "pattern": "/admin/bots",
      "route": "/admin/bots"
    },
    {
      "pattern": "/admin/users",
      "route": "/admin/users"
    },
    {
      "pattern": "/admin/users/[0-9a-fA-F-]{36}",
      "route": "/admin/users/{user_id}"
    },
    {
      "pattern": "/admin/users/[0-9a-fA-F-]{36}/password",
      "route": "/admin/users/{user_id}/password"
    },
    {
      "pattern": "/auth/login",
      "route": "/auth/login"
    },
    {
      "pattern": "/auth/logout",
      "route": "/auth/logout"
    },
    {
      "pattern": "/auth/me",
      "route": "/auth/me"
    },
    {
      "pattern": "/auth/password",
      "route": "/auth/password"
    },
    {
      "pattern": "/auth/refresh",
      "route": "/auth/refresh"
    },
    {
      "pattern": "/automations",
      "route": "/automations"
    },
    {
      "pattern": "/onec/ping",
      "route": "/onec/ping"
    },
    {
      "pattern": "/onec/stocks",
      "route": "/onec/stocks"
    },
    {
      "pattern": "/wb/box\\-stickers/build",
      "route": "/wb/box-stickers/build"
    },
    {
      "pattern": "/wb/box\\-stickers/check",
      "route": "/wb/box-stickers/check"
    },
    {
      "pattern": "/wb/card\\-checklist/sellers/[0-9a-fA-F-]{36}",
      "route": "/wb/card-checklist/sellers/{seller_id}"
    },
    {
      "pattern": "/wb/card\\-checklist/sellers/[0-9a-fA-F-]{36}/export",
      "route": "/wb/card-checklist/sellers/{seller_id}/export"
    },
    {
      "pattern": "/wb/card\\-checklist/sellers/[0-9a-fA-F-]{36}/refresh",
      "route": "/wb/card-checklist/sellers/{seller_id}/refresh"
    },
    {
      "pattern": "/wb/fbs\\-penalties/sellers/[0-9a-fA-F-]{36}",
      "route": "/wb/fbs-penalties/sellers/{seller_id}"
    },
    {
      "pattern": "/wb/fbs\\-penalties/sellers/[0-9a-fA-F-]{36}/export",
      "route": "/wb/fbs-penalties/sellers/{seller_id}/export"
    },
    {
      "pattern": "/wb/fbs\\-penalties/sellers/[0-9a-fA-F-]{36}/lookup",
      "route": "/wb/fbs-penalties/sellers/{seller_id}/lookup"
    },
    {
      "pattern": "/wb/fbs\\-penalties/sellers/[0-9a-fA-F-]{36}/refresh",
      "route": "/wb/fbs-penalties/sellers/{seller_id}/refresh"
    },
    {
      "pattern": "/wb/fbs\\-stocks/boards",
      "route": "/wb/fbs-stocks/boards"
    },
    {
      "pattern": "/wb/fbs\\-stocks/export",
      "route": "/wb/fbs-stocks/export"
    },
    {
      "pattern": "/wb/fbs\\-stocks/refresh",
      "route": "/wb/fbs-stocks/refresh"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}",
      "route": "/wb/fbs-stocks/sellers/{seller_id}"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/barcodes",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/barcodes"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/groups",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/groups"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/groups/order",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/groups/order"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/groups/[0-9a-fA-F-]{36}",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/groups/{group_id}"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/groups/[0-9a-fA-F-]{36}/columns",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/groups/{group_id}/columns"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/refresh",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/refresh"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/setup",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/setup"
    },
    {
      "pattern": "/wb/fbs/mapping",
      "route": "/wb/fbs/mapping"
    },
    {
      "pattern": "/wb/fbs/mapping/shares",
      "route": "/wb/fbs/mapping/shares"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/mapping",
      "route": "/wb/fbs/sellers/{seller_id}/mapping"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/mode",
      "route": "/wb/fbs/sellers/{seller_id}/mode"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/overview",
      "route": "/wb/fbs/sellers/{seller_id}/overview"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/plan",
      "route": "/wb/fbs/sellers/{seller_id}/plan"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/publications",
      "route": "/wb/fbs/sellers/{seller_id}/publications"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/publish",
      "route": "/wb/fbs/sellers/{seller_id}/publish"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/queue",
      "route": "/wb/fbs/sellers/{seller_id}/queue"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/sync",
      "route": "/wb/fbs/sellers/{seller_id}/sync"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/warehouses",
      "route": "/wb/fbs/sellers/{seller_id}/warehouses"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/warehouses/[0-9]+",
      "route": "/wb/fbs/sellers/{seller_id}/warehouses/{warehouse_id}"
    },
    {
      "pattern": "/wb/fbs/sellers/[0-9a-fA-F-]{36}/warehouses/[0-9]+/binding",
      "route": "/wb/fbs/sellers/{seller_id}/warehouses/{warehouse_id}/binding"
    },
    {
      "pattern": "/wb/fbs/setup",
      "route": "/wb/fbs/setup"
    },
    {
      "pattern": "/wb/fbs/setup/offices/[0-9]+",
      "route": "/wb/fbs/setup/offices/{office_id}"
    },
    {
      "pattern": "/wb/fbs/setup/regions",
      "route": "/wb/fbs/setup/regions"
    },
    {
      "pattern": "/wb/fbs/setup/settings",
      "route": "/wb/fbs/setup/settings"
    },
    {
      "pattern": "/wb/fbs/stock",
      "route": "/wb/fbs/stock"
    },
    {
      "pattern": "/wb/fbs/stock/history",
      "route": "/wb/fbs/stock/history"
    },
    {
      "pattern": "/wb/fbs/stock/pools",
      "route": "/wb/fbs/stock/pools"
    },
    {
      "pattern": "/wb/podsort",
      "route": "/wb/podsort"
    },
    {
      "pattern": "/wb/podsort/export",
      "route": "/wb/podsort/export"
    },
    {
      "pattern": "/wb/podsort/settings",
      "route": "/wb/podsort/settings"
    },
    {
      "pattern": "/wb/podsort/warehouses",
      "route": "/wb/podsort/warehouses"
    },
    {
      "pattern": "/wb/returns/extension/codes",
      "route": "/wb/returns/extension/codes"
    },
    {
      "pattern": "/wb/returns/extension/deliveries",
      "route": "/wb/returns/extension/deliveries"
    },
    {
      "pattern": "/wb/returns/extension/heartbeat",
      "route": "/wb/returns/extension/heartbeat"
    },
    {
      "pattern": "/wb/returns/extension/pair",
      "route": "/wb/returns/extension/pair"
    },
    {
      "pattern": "/wb/returns/sellers/[0-9a-fA-F-]{36}",
      "route": "/wb/returns/sellers/{seller_id}"
    },
    {
      "pattern": "/wb/returns/sellers/[0-9a-fA-F-]{36}/extension",
      "route": "/wb/returns/sellers/{seller_id}/extension"
    },
    {
      "pattern": "/wb/returns/sellers/[0-9a-fA-F-]{36}/extension/installs/[0-9a-fA-F-]{36}",
      "route": "/wb/returns/sellers/{seller_id}/extension/installs/{install_id}"
    },
    {
      "pattern": "/wb/returns/sellers/[0-9a-fA-F-]{36}/extension/pairing\\-code",
      "route": "/wb/returns/sellers/{seller_id}/extension/pairing-code"
    },
    {
      "pattern": "/wb/returns/sellers/[0-9a-fA-F-]{36}/invite\\-link",
      "route": "/wb/returns/sellers/{seller_id}/invite-link"
    },
    {
      "pattern": "/wb/returns/sellers/[0-9a-fA-F-]{36}/refresh",
      "route": "/wb/returns/sellers/{seller_id}/refresh"
    },
    {
      "pattern": "/wb/review\\-chats/sellers/[0-9a-fA-F-]{36}",
      "route": "/wb/review-chats/sellers/{seller_id}"
    },
    {
      "pattern": "/wb/review\\-chats/sellers/[0-9a-fA-F-]{36}/export",
      "route": "/wb/review-chats/sellers/{seller_id}/export"
    },
    {
      "pattern": "/wb/reviews/sellers/[0-9a-fA-F-]{36}/history",
      "route": "/wb/reviews/sellers/{seller_id}/history"
    },
    {
      "pattern": "/wb/reviews/sellers/[0-9a-fA-F-]{36}/report",
      "route": "/wb/reviews/sellers/{seller_id}/report"
    },
    {
      "pattern": "/wb/reviews/sync",
      "route": "/wb/reviews/sync"
    },
    {
      "pattern": "/wb/reviews/sync/latest",
      "route": "/wb/reviews/sync/latest"
    },
    {
      "pattern": "/wb/sellers",
      "route": "/wb/sellers"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}",
      "route": "/wb/sellers/{seller_id}"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/articles",
      "route": "/wb/sellers/{seller_id}/articles"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/catalog\\-sync",
      "route": "/wb/sellers/{seller_id}/catalog-sync"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/egress\\-verify",
      "route": "/wb/sellers/{seller_id}/egress-verify"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/mpstats",
      "route": "/wb/sellers/{seller_id}/mpstats"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/mpstats\\-verify",
      "route": "/wb/sellers/{seller_id}/mpstats-verify"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/ozon",
      "route": "/wb/sellers/{seller_id}/ozon"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/ozon\\-verify",
      "route": "/wb/sellers/{seller_id}/ozon-verify"
    },
    {
      "pattern": "/wb/sellers/[0-9a-fA-F-]{36}/restore",
      "route": "/wb/sellers/{seller_id}/restore"
    },
    {
      "pattern": "/wb/turnover/sellers/[0-9a-fA-F-]{36}/articles",
      "route": "/wb/turnover/sellers/{seller_id}/articles"
    },
    {
      "pattern": "/wb/turnover/sellers/[0-9a-fA-F-]{36}/invite\\-link",
      "route": "/wb/turnover/sellers/{seller_id}/invite-link"
    },
    {
      "pattern": "/wb/turnover/sellers/[0-9a-fA-F-]{36}/refresh",
      "route": "/wb/turnover/sellers/{seller_id}/refresh"
    },
    {
      "pattern": "/wb/turnover/sellers/[0-9a-fA-F-]{36}/replenishment",
      "route": "/wb/turnover/sellers/{seller_id}/replenishment"
    },
    {
      "pattern": "/admin/bots/[^/]+",
      "route": "/admin/bots/{code}"
    },
    {
      "pattern": "/automations/[^/]+/sellers",
      "route": "/automations/{automation_id}/sellers"
    },
    {
      "pattern": "/automations/[^/]+/sellers/[0-9a-fA-F-]{36}",
      "route": "/automations/{automation_id}/sellers/{seller_id}"
    },
    {
      "pattern": "/wb/card\\-checklist/sellers/[0-9a-fA-F-]{36}/articles/[^/]+/comment",
      "route": "/wb/card-checklist/sellers/{seller_id}/articles/{article}/comment"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/barcodes/[^/]+",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/barcodes/{barcode}"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/barcodes/[^/]+/hidden",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/barcodes/{barcode}/hidden"
    },
    {
      "pattern": "/wb/fbs\\-stocks/sellers/[0-9a-fA-F-]{36}/barcodes/[^/]+/note",
      "route": "/wb/fbs-stocks/sellers/{seller_id}/barcodes/{barcode}/note"
    },
    {
      "pattern": "/wb/returns/qr/[0-9a-fA-F-]{36}/[^/]+/[^/]+\\.png",
      "route": "/wb/returns/qr/{seller_id}/{day}/{signature}.png"
    },
    {
      "pattern": ".*",
      "route": "/[unknown]"
    }
  ],
  "services": [
    {
      "id": "api",
      "name": "API",
      "prefix": "/",
      "health_url": "http://karbi-api-1:8000/api/v1/health/ready",
      "health_body": {
        "database": true,
        "redis": true
      }
    },
    {
      "id": "frontend",
      "name": "Фронтенд",
      "prefix": "/-/frontend",
      "health_url": "http://karbi-frontend-1/health"
    },
    {
      "id": "admin",
      "name": "Админка",
      "prefix": "/admin"
    },
    {
      "id": "auth",
      "name": "Вход",
      "prefix": "/auth"
    },
    {
      "id": "automations",
      "name": "Каталог автоматизаций",
      "prefix": "/automations"
    },
    {
      "id": "onec",
      "name": "1С",
      "prefix": "/onec"
    },
    {
      "id": "wb-box-stickers",
      "name": "Стикеры коробов",
      "prefix": "/wb/box-stickers"
    },
    {
      "id": "wb-card-checklist",
      "name": "Чек-лист карточек",
      "prefix": "/wb/card-checklist"
    },
    {
      "id": "wb-fbs",
      "name": "Распределение FBS",
      "prefix": "/wb/fbs"
    },
    {
      "id": "wb-fbs-penalties",
      "name": "Штрафы FBS",
      "prefix": "/wb/fbs-penalties"
    },
    {
      "id": "wb-fbs-stocks",
      "name": "Остатки FBS",
      "prefix": "/wb/fbs-stocks"
    },
    {
      "id": "wb-podsort",
      "name": "Подсорт",
      "prefix": "/wb/podsort"
    },
    {
      "id": "wb-returns",
      "name": "Возвраты",
      "prefix": "/wb/returns"
    },
    {
      "id": "wb-review-chats",
      "name": "Чаты после отзыва",
      "prefix": "/wb/review-chats"
    },
    {
      "id": "wb-reviews",
      "name": "Отзывы",
      "prefix": "/wb/reviews"
    },
    {
      "id": "wb-sellers",
      "name": "Селлеры",
      "prefix": "/wb/sellers"
    },
    {
      "id": "wb-turnover",
      "name": "Оборачиваемость",
      "prefix": "/wb/turnover"
    }
  ]
}
