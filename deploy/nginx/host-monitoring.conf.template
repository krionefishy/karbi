# Мониторинг: отдельный стек (github.com/krionefishy/monitoring) со своими
# пользователями и базой, слушает 127.0.0.1:8088. Шаблон рендерится, только
# когда в .env задан MONITORING_DOMAIN. Порядок установки — docs/MONITORING.md.

server {
    listen 80;
    listen [::]:80;
    server_name ${MONITORING_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${MONITORING_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${MONITORING_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MONITORING_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 8k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        access_log off;
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Ровно один адрес, без $proxy_add_x_forwarded_for: по нему мониторинг
        # считает попытки входа, и клиент не должен уметь подставить свой.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
