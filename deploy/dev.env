# Local-development defaults for deploy/compose.yaml.
# The compose file itself has NO fallbacks for secrets (production-first),
# so local runs must pass this file: docker compose --env-file deploy/dev.env ...
# `just compose-up` already does. NEVER use these values on a server.
APP_ENVIRONMENT=docker
DB_PASSWORD=karbi
REDIS_PASSWORD=karbi
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
# A syntactically valid Fernet key, published in the repository: dev only.
CREDENTIALS_ENCRYPTION_KEYS=7AjHeClPFTGfmZRHTiPQ-J-RuPxAX7jGq20uGt90fec=
CREDENTIALS_FINGERPRINT_KEY=dev-only-fingerprint-key-32-chars-long
