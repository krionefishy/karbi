{
  "manifest_version": 3,
  "name": "Marketplace Auto — скриншоты",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Отправляет скриншот чата WB с исходом в Marketplace Auto.",
  "permissions": ["activeTab", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Отправить скриншот" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Отправить скриншот" }
  }
}
